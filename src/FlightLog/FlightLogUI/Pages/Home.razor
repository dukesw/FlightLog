                //chartOptions.XAxisTitle = "Week";
                chartOptions.YAxisTicks = 2;
                //chartOptions.YAxisSuggestedMax = recentFlightsGroupedByWeek.Max(x => x.FlightCount) + 2;
            }
            return;
        } 
        if (graphType == 2)
        {
            if (recentFlightsGroupedByMonth != null)
            {
                graphSeries = new List<ChartSeries<int>> { new ChartSeries<int>() { Name = "Flight Month", Data = recentFlightsGroupedByMonth.Select(x => x.FlightCount).ToArray() } };
                graphAxisLabels = recentFlightsGroupedByMonth.Select(x => x.PeriodName).ToArray();
                //chartOptions.XAxisTitle = "Month";
                chartOptions.YAxisTicks = 5;
            }
            return;
        }
    }

