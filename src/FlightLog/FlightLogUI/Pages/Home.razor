    private async Task OnGraphTypeChanged()
    {
        if (graphType == 1)
        {
            if (recentFlightsGroupedByWeek != null)
            {
                graphSeries = new List<ChartSeries<int>> { new ChartSeries<int>() { Name = "Flight Week", Data = recentFlightsGroupedByWeek.Select(x => x.FlightCount).ToArray() } };
