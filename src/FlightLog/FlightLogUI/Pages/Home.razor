@using MudBlazor
@using MudBlazor.Charts;

@page "/"
@attribute [Authorize]

@inject IHttpClientFactory ClientFactory
@inject IAccessTokenProvider AccessTokenProvider
@inject AuthenticationStateProvider AuthStateProvider

<h3>Flights</h3>
<p>Welcome to Flight Log - the app to enter and manage your RC flights. </p>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />

}
else 
{
    @if (recentFlightsGroupedByWeek == null)
    {
        <p>No flights recently.</p>
    }
    else
    {
        <MudChart ChartType="ChartType.Bar" ChartSeries="@graphSeries" ChartLabels=@graphAxisLabels ChartOptions="chartOptions" MatchBoundsToSize="true" >

        </MudChart>
        <MudToggleGroup T="int" Size="Size.Small" @bind-Value="graphType" @bind-Value:after="OnGraphTypeChanged" Style="width: 15rem">
            <MudToggleItem Value=1 Text="Weekly" />
            <MudToggleItem Value=2 Text="Monthly" />
        </MudToggleGroup>


        @* <ul>
        @foreach (var flight in recentFlightsGroupedByWeek)
        {
            <li>Period: @flight.PeriodName, Flights: @flight.FlightCount</li>
        }
    </ul>
    <p>Monthly</p>
    <ul>
        @foreach (var flight in recentFlightsGroupedByMonth)
        {
            <li>Period: @flight.PeriodName, Flights: @flight.FlightCount</li>
        }
     </ul> *@
    }
}
